{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=itam;Username=itam;Password=change-me"
  },
  "Server": {
    "Urls": "http://0.0.0.0:8080",
    "HttpsCertificatePath": "",
    "HttpsCertificatePassword": "",
    "UseForwardedHeaders": true,
    "EnableSwagger": true
  },
  "Itam": {
    "DataRoot": "",
    "AutoMigrate": true
  },
  "Security": {
    "RequireHttpsCookies": false,
    "LoginRateLimitPerMinute": 10,
    "ApiRateLimitPerMinute": 1200
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": ""
  },
  "Backup": {
    "Directory": "",
    "PgBinPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
