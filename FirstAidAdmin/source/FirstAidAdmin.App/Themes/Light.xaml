<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: every control uses these keys through DynamicResource so the theme can be switched at runtime. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D2433"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7385"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E3E7EF"/>
    <SolidColorBrush x:Key="TileBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#EBF4FF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2C5282"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1F9D55"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D69E2E"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#E53E3E"/>
    <SolidColorBrush x:Key="CritBrush" Color="#9B2C2C"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3182CE"/>
    <SolidColorBrush x:Key="SkipBrush" Color="#A0AEC0"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A5F" Offset="0"/>
        <GradientStop Color="#2B6CB0" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
