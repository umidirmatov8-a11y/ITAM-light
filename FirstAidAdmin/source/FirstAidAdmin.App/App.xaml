<Application x:Class="FirstAidAdmin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FirstAidAdmin.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FirstAidAdmin;component/Themes/Light.xaml"/>
                <ResourceDictionary Source="/FirstAidAdmin;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusBrushConverter x:Key="StatusBrush"/>
            <conv:BoolToVisibilityConverter x:Key="Vis"/>
            <conv:BoolToVisibilityConverter x:Key="InvVis" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
