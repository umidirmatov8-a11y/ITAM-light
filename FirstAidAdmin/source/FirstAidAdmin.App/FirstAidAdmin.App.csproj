<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FirstAidAdmin</AssemblyName>
    <RootNamespace>FirstAidAdmin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- Single-file, self-contained publish (dotnet publish -c Release -r win-x64 with self-contained enabled) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <ProjectReference Include="..\FirstAidAdmin.Application\FirstAidAdmin.Application.csproj" />
    <Resource Include="Assets\app.ico" />
    <None Include="..\..\KnowledgeBase\*.json" Link="KnowledgeBase\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The elevated helper is published next to FirstAidAdmin.exe when the app project is published on its own
       (a solution-level publish already publishes the helper project). -->
  <Target Name="PublishHelper" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' and ('$(SolutionPath)' == '' or '$(SolutionPath)' == '*Undefined*')">
    <MSBuild Projects="..\FirstAidAdmin.Helper\FirstAidAdmin.Helper.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;DebugType=embedded" />
  </Target>
</Project>
