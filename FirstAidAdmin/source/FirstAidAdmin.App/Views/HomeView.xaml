<UserControl x:Class="FirstAidAdmin.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20" MaxWidth="1100">
            <Grid Margin="8,0,8,10">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,10"
                       Text="Выберите проблему — программа сама выполнит нужные проверки, найдёт вероятную причину и предложит действия."/>

            <!-- Primary tiles -->
            <ItemsControl ItemsSource="{Binding Primary}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Command="{Binding Command}" ToolTip="{Binding Description}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="34" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" MaxWidth="240">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Secondary (admin mode) -->
            <ItemsControl ItemsSource="{Binding Secondary}" Visibility="{Binding IsHelpDesk, Converter={StaticResource InvVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" MinHeight="60" Command="{Binding Command}" ToolTip="{Binding Description}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Big actions -->
            <UniformGrid Columns="2" Margin="0,8,0,0" Visibility="{Binding IsHelpDesk, Converter={StaticResource InvVis}}">
                <Button Style="{StaticResource TileButton}" Command="{Binding FirstResponse.Command}" BorderBrush="{DynamicResource WarnBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚑" FontSize="38" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FIRST RESPONSE" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Первичная картина за 1–3 минуты: сеть, DNS, диски, производительность, безопасность, службы, журналы" Style="{StaticResource Muted}" FontSize="12" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Command="{Binding Full.Command}" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🩺" FontSize="38" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ПОЛНАЯ ДИАГНОСТИКА" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Все модули (длительные SFC / DISM ScanHealth — отдельно, по запросу)" Style="{StaticResource Muted}" FontSize="12" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"
                       Text="🔒 Диагностика работает локально и без Интернета. Ничего не исправляется без вашего подтверждения. Телеметрия отключена."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
