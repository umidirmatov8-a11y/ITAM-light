<UserControl x:Class="FirstAidAdmin.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="⚙ Настройки" Style="{StaticResource H1}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <TextBlock Text="Язык:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="80" ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.General.Language}"/>
                        <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox Width="110" ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.General.Theme}"/>
                        <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding Modes}" SelectedItem="{Binding Settings.General.Mode}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="HelpDesk — упрощённый режим «Что говорит пользователь?»; Administrator — все сценарии."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <TextBlock Text="Таймаут команд, с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="60" Text="{Binding Settings.Diagnostics.CommandTimeoutSeconds}"/>
                        <TextBlock Text="Количество ping:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="50" Text="{Binding Settings.Diagnostics.PingCount}"/>
                        <TextBlock Text="Таймаут ping, мс:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="70" Text="{Binding Settings.Diagnostics.PingTimeoutMs}"/>
                        <TextBlock Text="Журналы за, ч:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="50" Text="{Binding Settings.Diagnostics.EventLogHours}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="IP для проверки Интернета:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="220" Text="{Binding InternetProbeIps}"/>
                        <TextBlock Text="Эталонные DNS:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="200" Text="{Binding ReferenceDns}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Отключённые модули (id через запятую):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="320" Text="{Binding DisabledModules}" ToolTip="network, dns, wifi, domain, ad, rdp, printer, windowsupdate, storage, windowshealth, security, performance, services, eventlog"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Порог диска, % (предупр./крит.):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding Settings.Diagnostics.DiskWarningPercent}"/>
                        <TextBox Width="50" Margin="4,0,0,0" Text="{Binding Settings.Diagnostics.DiskCriticalPercent}"/>
                        <TextBlock Text="RAM, %:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Width="50" Text="{Binding Settings.Diagnostics.RamWarningPercent}"/>
                        <TextBox Width="50" Margin="4,0,0,0" Text="{Binding Settings.Diagnostics.RamCriticalPercent}"/>
                    </WrapPanel>
                    <CheckBox Content="Загружать плагины из папки Plugins (только доверенные DLL)" IsChecked="{Binding Settings.Diagnostics.LoadPlugins}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Security" Style="{StaticResource H2}"/>
                    <CheckBox Content="Подтверждение перед любым исправлением (всегда включено)" IsChecked="True" IsEnabled="False"/>
                    <TextBlock Text="Маскирование данных при экспорте пакета:" Margin="0,8,0,2"/>
                    <CheckBox Content="Имена пользователей (DOMAIN\username → DOMAIN\USER)" IsChecked="{Binding Settings.Security.RedactUserNames}"/>
                    <CheckBox Content="Имя компьютера" IsChecked="{Binding Settings.Security.RedactHostNames}"/>
                    <CheckBox Content="Домен" IsChecked="{Binding Settings.Security.RedactDomain}"/>
                    <CheckBox Content="IP-адреса (последние два октета)" IsChecked="{Binding Settings.Security.RedactIpAddresses}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Пароли, токены, cookies, документы и почта не собираются никогда. Телеметрия: выключена и не реализована."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Reports" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <TextBlock Text="Папка отчётов:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="420" Text="{Binding Settings.Reports.ReportFolder}" ToolTip="{Binding ReportFolderHint}"/>
                        <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox Width="90" ItemsSource="{Binding Formats}" SelectedItem="{Binding Settings.Reports.Format}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                        <Run Text="Пусто = "/><Run Text="{Binding ReportFolderHint, Mode=OneWay}"/>
                    </TextBlock>
                    <CheckBox Content="Автоматически собирать ZIP при сохранении отчёта" IsChecked="{Binding Settings.Reports.AutoZip}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Экспорт PDF — planned (сейчас: откройте report.html → Печать → Сохранить как PDF)."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Optional AI Assistant" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Не используется. Вся диагностика и корреляция выполняются локальными правилами (LocalRuleEngine) без Интернета и внешних API. Интерфейс IAnalysisProvider подготовлен для будущего опционального ассистента."/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="💾 Сохранить" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                <Run Text="Файл настроек: "/><Run Text="{Binding SettingsPath, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
