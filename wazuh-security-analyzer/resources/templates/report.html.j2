<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.title }}</title>
<style>
  :root { --bg:#0f141a; --panel:#161d26; --text:#e6edf3; --muted:#8b949e; --line:#26303c; --accent:#3fa9f5;
          --critical:#ff3b5c; --high:#ff8a3d; --medium:#f5c542; --low:#3fa9f5; --informational:#8b949e; }
  @media print { :root { --bg:#fff; --panel:#fff; --text:#111; --muted:#555; --line:#ccc; } }
  body { background:var(--bg); color:var(--text); font:14px/1.5 "Segoe UI", Roboto, Arial, sans-serif; margin:0; }
  main { max-width:1100px; margin:0 auto; padding:24px 16px 64px; }
  h1 { font-size:26px; margin:0 0 4px; } h2 { font-size:19px; margin:32px 0 10px; border-bottom:1px solid var(--line); padding-bottom:6px; }
  h3 { font-size:15px; margin:18px 0 6px; }
  .muted { color:var(--muted); } .card { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:14px 16px; margin:10px 0; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
  .stat { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:12px; }
  .stat b { display:block; font-size:24px; } .sev { display:inline-block; padding:1px 8px; border-radius:10px; font-weight:600; font-size:12px; color:#111; }
  .sev-critical{background:var(--critical);color:#fff} .sev-high{background:var(--high)} .sev-medium{background:var(--medium)} .sev-low{background:var(--low)} .sev-informational{background:var(--informational)}
  table { width:100%; border-collapse:collapse; font-size:13px; } th,td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-weight:600; } .wrap { overflow-x:auto; } code { font-family:Consolas, monospace; font-size:12px; word-break:break-all; }
  .chain { font-weight:600; } ul { margin:4px 0 4px 20px; padding:0; } .exec p { margin:0 0 10px; }
</style>
</head>
<body><main>
<h1>{{ r.title }}</h1>
<div class="muted">{{ t("Generated") }} {{ r.generated_at }} &middot; {{ r.app }} &middot; {{ t("Mode") }}: {{ t(r.summary.mode|upper) }}
{% if r.summary.first_ts %}&middot; {{ t("Period") }}: {{ ts(r.summary.first_ts) }} &ndash; {{ ts(r.summary.last_ts) }}{% endif %}</div>

{% if r.has('executive_summary') %}
<h2>{{ t("Executive Summary") }}</h2>
<div class="card exec">{% for p in r.summary.executive_summary.split('\n\n') %}<p>{{ p }}</p>{% endfor %}</div>
{% endif %}

{% if r.has('statistics') %}
<h2>{{ t("Statistics") }}</h2>
<div class="grid">
{% for sev in ['critical','high','medium','low','informational'] %}
  <div class="stat"><span class="sev sev-{{ sev }}">{{ sl(sev) }}</span><b>{{ num(r.summary.severity_counts.get(sev, 0)) }}</b><span class="muted">{{ t("events") }}</span></div>
{% endfor %}
  <div class="stat"><b>{{ num(r.summary.events) }}</b><span class="muted">{{ t("total events") }}</span></div>
  <div class="stat"><b>{{ r.summary.files }}</b><span class="muted">{{ t("files") }}</span></div>
  <div class="stat"><b>{{ r.summary.agents }}</b><span class="muted">{{ t("agents") }}</span></div>
  <div class="stat"><b>{{ r.summary.rules }}</b><span class="muted">{{ t("rules") }}</span></div>
  <div class="stat"><b>{{ r.summary.incidents }}</b><span class="muted">{{ t("incidents") }}</span></div>
  <div class="stat"><b>{{ r.summary.affected_hosts }}</b><span class="muted">{{ t("affected hosts") }}</span></div>
  <div class="stat"><b>{{ r.summary.affected_users }}</b><span class="muted">{{ t("affected users") }}</span></div>
  <div class="stat"><b>{{ r.summary.external_ips }}</b><span class="muted">{{ t("external IPs") }}</span></div>
  <div class="stat"><b>{{ r.summary.cves }}</b><span class="muted">CVE</span></div>
  <div class="stat"><b>{{ r.summary.mitre_techniques }}</b><span class="muted">{{ t("MITRE techniques") }}</span></div>
</div>
{% endif %}

{% if r.has('incidents') %}
<h2>{{ t("Incidents") }}</h2>
{% for i in r.incidents[:50] %}
<div class="card">
  <h3>{{ i.id }} &middot; {{ i.title }} <span class="sev sev-{{ i.severity }}">{{ sl(i.severity) }}</span></h3>
  <div class="muted">{{ t("Assessment") }}: <b>{{ t(i.assessment) }}</b> &middot; {{ t("Risk") }} {{ "%.0f"|format(i.risk_score) }}/100 &middot; {{ t("Confidence") }} {{ "%.0f"|format(i.confidence*100) }}% &middot; {{ t("False positive probability") }} {{ "%.0f"|format(i.fp_probability*100) }}% &middot; {{ t("Status") }}: {{ t(i.status) }}</div>
  <p>{{ i.summary }}</p>
  {% if i.chain %}<p class="chain">{{ i.chain|join(' → ') }}</p>{% endif %}
  <table>
    <tr><th>{{ t("Events") }}</th><td>{{ num(i.event_count) }}</td><th>{{ t("Period") }}</th><td>{{ ts(i.first_ts) }} &ndash; {{ ts(i.last_ts) }}</td></tr>
    <tr><th>{{ t("Hosts") }}</th><td>{{ i.affected_hosts[:10]|join(', ') or '-' }}</td><th>{{ t("Accounts") }}</th><td>{{ i.affected_users[:10]|join(', ') or '-' }}</td></tr>
    <tr><th>{{ t("Sources") }}</th><td>{{ i.source_ips[:10]|join(', ') or '-' }}</td><th>MITRE</th><td>{% for m in i.mitre[:8] %}{{ m.technique_id }} {{ m.name }} ({{ t(m.confidence) }}){% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
  </table>
  {% if i.evidence %}<h3>{{ t("Evidence") }}</h3><ul>{% for e in i.evidence %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
  {% if i.reasoning %}<h3>{{ t("Reasoning") }}</h3><ul>{% for e in i.reasoning %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
  {% for key, label in sections %}{% if i.recommendations.get(key) %}<h3>{{ t(label) }}</h3><ul>{% for s in i.recommendations[key] %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}{% endfor %}
</div>
{% else %}<p class="muted">{{ t("No incidents.") }}</p>{% endfor %}
{% endif %}

{% if r.has('critical_alerts') %}
<h2>{{ t("Critical and High Alerts") }}</h2>
<div class="wrap"><table>
<tr><th>ID</th><th>{{ t("Severity") }}</th><th>{{ t("Risk") }}</th><th>{{ t("Finding") }}</th><th>{{ t("Host") }}</th><th>{{ t("Source") }}</th><th>{{ t("Count") }}</th><th>{{ t("Assessment") }}</th></tr>
{% for g in r.alerts[:200] %}
<tr><td>{{ g.display_id }}</td><td><span class="sev sev-{{ g.severity }}">{{ sl(g.severity) }}</span></td><td>{{ "%.0f"|format(g.risk_score) }}</td>
<td><b>{{ g.title }}</b><br><span class="muted">{{ g.what_happened }}</span></td><td>{{ g.agent_name }}</td><td>{{ g.src_ip }}</td><td>{{ num(g.count) }}</td><td>{{ t(g.assessment) }}</td></tr>
{% endfor %}
</table></div>
{% endif %}

{% if r.has('hosts') %}
<h2>{{ t("Affected Hosts") }}</h2>
<div class="wrap"><table><tr><th>{{ t("Host") }}</th><th>{{ t("Severity") }}</th><th>{{ t("Max risk") }}</th><th>{{ t("Events") }}</th><th>{{ t("Incidents") }}</th><th>{{ t("Criticality") }}</th></tr>
{% for h in r.hosts[:100] %}<tr><td>{{ h.name }}</td><td><span class="sev sev-{{ h.severity }}">{{ sl(h.severity) }}</span></td><td>{{ "%.0f"|format(h.max_risk) }}</td><td>{{ num(h.events) }}</td><td>{{ h.incidents }}</td><td>{{ t(h.data.get('criticality','')) }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.has('users') %}
<h2>{{ t("Users") }}</h2>
<div class="wrap"><table><tr><th>{{ t("Account") }}</th><th>{{ t("Severity") }}</th><th>{{ t("Max risk") }}</th><th>{{ t("Events") }}</th><th>{{ t("Hosts") }}</th></tr>
{% for u in r.users[:100] %}<tr><td>{{ u.name }}</td><td><span class="sev sev-{{ u.severity }}">{{ sl(u.severity) }}</span></td><td>{{ "%.0f"|format(u.max_risk) }}</td><td>{{ num(u.events) }}</td><td>{{ u.data.get('hosts', [])[:5]|join(', ') }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.has('iocs') %}
<h2>{{ t("Indicators of Compromise (external)") }}</h2>
<div class="wrap"><table><tr><th>{{ t("Type") }}</th><th>{{ t("Value") }}</th><th>{{ t("Verdict") }}</th><th>{{ t("Occurrences") }}</th><th>{{ t("Hosts") }}</th><th>{{ t("Sources") }}</th></tr>
{% for i in r.iocs[:200] %}<tr><td>{{ i.type }}</td><td><code>{{ i.value }}</code></td><td>{{ t(i.verdict) }}</td><td>{{ num(i.count) }}</td><td>{{ i.hosts[:5]|join(', ') }}</td><td>{% for s in i.sources[:3] %}{{ s.provider }}: {{ t(s.verdict) }}{% if s.score %} ({{ s.score }}){% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.has('cves') %}
<h2>{{ t("Vulnerabilities (CVE)") }}</h2>
{% for c in r.cves[:100] %}
<div class="card"><h3>{{ c.cve }} {% if c.known_exploited %}<span class="sev sev-critical">{{ t("KNOWN EXPLOITED") }}</span>{% endif %}</h3>
<div class="muted">CVSS {{ c.cvss if c.cvss is not none else 'n/a' }} {{ sl(c.severity) if c.severity else '' }} &middot; {{ t("Hosts") }}: {{ c.hosts[:10]|join(', ') }} &middot; {{ t("Packages") }}: {{ c.packages[:5]|join(', ') }}</div>
{% if c.description %}<p>{{ c.description }}</p>{% endif %}
<p><b>{{ t("Remediation") }}:</b> {{ c.remediation }}</p>
<div class="muted">{{ t("Sources") }}: {% for ref in c.references[:6] %}<a href="{{ ref.url }}">{{ ref.tags or ref.url }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</div></div>
{% else %}<p class="muted">{{ t("No CVE detected.") }}</p>{% endfor %}
{% endif %}

{% if r.has('mitre') %}
<h2>MITRE ATT&amp;CK</h2>
<div class="wrap"><table><tr><th>{{ t("Technique") }}</th><th>{{ t("Tactics") }}</th><th>{{ t("Events") }}</th><th>{{ t("Confidence") }}</th><th>{{ t("Evidence") }}</th></tr>
{% for m in r.mitre[:100] %}<tr><td><a href="{{ m.url }}">{{ m.technique_id }}</a> {{ m.name }}</td><td>{{ m.tactics|join(', ') }}</td><td>{{ num(m.events) }}</td><td>{{ t(m.confidence) }}</td><td>{{ m.evidence[:2]|join('; ') }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.has('recommendations') %}
<h2>{{ t("Recommendations") }}</h2>
{% for key, label in sections %}{% if r.recommendations.get(key) %}<h3>{{ t(label) }}</h3><ul>{% for s in r.recommendations[key] %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}{% endfor %}
{% endif %}

{% if r.has('timeline') %}
<h2>{{ t("Timeline (critical / high incidents)") }}</h2>
<div class="wrap"><table><tr><th>{{ t("Start") }}</th><th>{{ t("End") }}</th><th>{{ t("Severity") }}</th><th>{{ t("Event") }}</th></tr>
{% for item in r.timeline %}<tr><td>{{ ts(item.ts) }}</td><td>{{ ts(item.end) }}</td><td><span class="sev sev-{{ item.severity }}">{{ sl(item.severity) }}</span></td><td>{{ item.text }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.has('appendix') %}
<h2>{{ t("Technical Appendix") }}</h2>
<div class="card">
<p><b>{{ t("Input files") }}:</b> {{ r.appendix.files|join(', ') }}</p>
<p><b>{{ t("Parsers") }}:</b> {% for k, v in r.appendix.parsers.items() %}{{ k }} ({{ "{:,}".format(v) }}){% if not loop.last %}, {% endif %}{% endfor %}</p>
<p><b>{{ t("Duplicates removed") }}:</b> {{ r.appendix.duplicates }} &middot; <b>{{ t("Malformed records skipped") }}:</b> {{ r.appendix.parse_errors }} &middot; <b>{{ t("Analysis time") }}:</b> {{ r.appendix.duration }} s</p>
<p><b>{{ t("Risk scale") }}:</b> {{ r.appendix.severity_scale }}. {{ t("The risk score combines Wazuh rule level, asset criticality, frequency, source location, authentication outcome, IOC reputation, CVE severity, MITRE technique and correlation, reduced by the estimated false-positive probability.") }}</p>
{% if r.appendix.rejected %}<p><b>{{ t("Rejected inputs") }}:</b></p><ul>{% for x in r.appendix.rejected %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
<h3>{{ t("Top rules") }}</h3><table><tr><th>{{ t("Rule") }}</th><th>{{ t("Description") }}</th><th>{{ t("Events") }}</th></tr>
{% for rid, desc, cnt in r.appendix.top_rules %}<tr><td>{{ rid }}</td><td>{{ desc }}</td><td>{{ num(cnt) }}</td></tr>{% endfor %}</table>
<p class="muted">{{ t("Statements in this report distinguish observed facts (evidence) from analytical conclusions (assessment). An assessment such as \"possible attack\" is not proof of compromise.") }}</p>
</div>
{% endif %}
</main></body></html>
