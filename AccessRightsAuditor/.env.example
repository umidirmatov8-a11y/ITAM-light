# Подключение к PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=ara
PGUSER=ara
PGPASSWORD=
# PGSSLMODE=require        # если БД на другом хосте: require или verify-full
# DATABASE_URL=postgres://ara:password@localhost:5432/ara

# Сервер ARA (по умолчанию доступен только с этого компьютера)
ARA_HOST=127.0.0.1
ARA_PORT=3000
ARA_DATA_DIR=data

# Первый администратор (если не задан пароль — будет сгенерирован и выведен в консоль)
ARA_ADMIN_USERNAME=admin
# ARA_ADMIN_PASSWORD=

# Путь к pg_dump для резервного копирования из интерфейса
# ARA_PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe

# ARA_SECURE_COOKIES=true  # если приложение открыто через HTTPS
