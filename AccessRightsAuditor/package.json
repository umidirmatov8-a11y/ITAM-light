{
  "name": "access-rights-auditor",
  "version": "1.0.0",
  "private": true,
  "description": "Access Rights Auditor (ARA) — локальная система аудита банковских полномочий",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "test": "npm test -w server",
    "migrate": "npm run migrate -w server",
    "seed:demo": "npm run seed:demo -w server",
    "create-admin": "npm run create-admin -w server"
  }
}
